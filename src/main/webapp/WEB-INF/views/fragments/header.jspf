<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<%-- Barre de navigation commune.
     Connecté    : lien vers son espace (activeNav = "patients" ou "dossier" dans la page)
                   + initiale et email + bouton de déconnexion (assets/js/app.js).
     Non connecté : bouton "Se connecter" (caché si la page met hideLoginLink à true). --%>
<c:set var="ctx" value="${pageContext.request.contextPath}" />
<header class="site-header">
    <div class="container">
        <%@ include file="logo.jspf" %>
        <c:choose>
            <c:when test="${not empty sessionScope.user}">
                <nav class="site-nav" aria-label="Navigation principale">
                    <c:choose>
                        <c:when test="${sessionScope.role == 'MEDECIN'}">
                            <a class="nav-link" href="${ctx}/patients"
                               <c:if test="${activeNav == 'patients'}">aria-current="page"</c:if>>Patients</a>
                        </c:when>
                        <c:when test="${sessionScope.role == 'PATIENT'}">
                            <a class="nav-link" href="${ctx}/mon-dossier"
                               <c:if test="${activeNav == 'dossier'}">aria-current="page"</c:if>>Mon dossier</a>
                        </c:when>
                    </c:choose>
                    <span class="site-user">
                        <span class="avatar" aria-hidden="true">${fn:toUpperCase(fn:substring(sessionScope.user.email, 0, 1))}</span>
                        <c:out value="${sessionScope.user.email}" />
                    </span>
                    <button type="button" class="btn btn-secondary" data-logout>Se déconnecter</button>
                </nav>
            </c:when>
            <c:when test="${not hideLoginLink}">
                <a class="btn btn-primary" href="${ctx}/login">Se connecter</a>
            </c:when>
        </c:choose>
    </div>
</header>
